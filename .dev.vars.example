# Local secrets for `npm run dev` / `wrangler dev`. Copy to .dev.vars (gitignored).
# Production values are set with: npx wrangler secret put <NAME>
AUTH_SECRET="replace-with-64-random-chars"          # openssl rand -base64 48
ADMIN_PASSWORD="choose-a-strong-admin-password"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"
