# CHATBOT DUAL ROUTER CONFIGURATION (NVIDIA NIM & OPENROUTER)
# Routing Mode: 'auto' | 'nim' | 'openrouter'
CHAT_ROUTING_MODE="auto"

# 1. NVIDIA NIM API CONFIGURATION
# Get your NVIDIA NIM API Key from: https://build.nvidia.com/
NVIDIA_NIM_API_KEY="MY_NVIDIA_NIM_API_KEY"
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NIM_DEFAULT_MODEL="meta/llama-3.3-70b-instruct"

# 2. OPENROUTER API CONFIGURATION
# Get your OpenRouter API Key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
